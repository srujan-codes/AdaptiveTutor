# ============================================================
# AdaptiveTutor Backend — Environment Variables
# Copy this file to .env and fill in real values.
#   cp .env.example .env
# NEVER commit .env to version control.
# ============================================================

# --- Application ---
# Application name (used in API docs title)
APP_NAME=AdaptiveTutor

# Application version
APP_VERSION=0.1.0

# Debug mode (set to true for verbose SQL logging; false in production)
DEBUG=false

# --- Database ---
# SQLite for local development:
DATABASE_URL=sqlite+aiosqlite:///./adaptivetutor.db
# PostgreSQL for production (uncomment and set):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/adaptivetutor

# --- Authentication (JWT) ---
# Secret key for signing JWT tokens — MUST be changed in production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE-ME-generate-a-real-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# --- Groq API ---
# Get your API key from: https://console.groq.com/
GROQ_API_KEY=gsk_your-api-key-here

# Groq model to use for all AI agents
CLAUDE_MODEL=llama-3.3-70b-versatile

# --- CORS ---
# Comma-separated list of allowed origins
# Local dev frontend (Vite default port):
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
